{
  // Cloudflare Workers + 静态资源（Cloudflare 控制台里 "Import a repository" 走的就是 `wrangler deploy`）
  "name": "okuki-personal-web",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-10",

  // 注：曾有 "placement": { "mode": "smart" }（就近执行），但它是 Workers 付费计划才有的能力，
  // 免费计划加上去会导致部署失败，所以保留注释、不启用。等升级计划再打开。

  // dist/ 作为静态资源；找不到的路径回 index.html（单页应用）
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },

  // 境内云函数的地址（腾讯云开发 / 阿里云 FC）。
  // 填了之后 /api/* 会被反向代理过去；留空则用 Worker 本地函数（境外拿不到播放地址）。
  // 例：https://okuki-api-123456.service.tcloudbase.com
  "vars": {
    "API_ORIGIN": ""
  },

  // 构建产物观察（Worker 只在小体积时启动快，静态文件不进 Worker）
  "observability": {
    "enabled": true
  }
}
