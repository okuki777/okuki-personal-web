# 方法二：用环境变量覆盖 src/config.js（Vercel / Cloudflare Pages 里填这个）
# 注意：README 明确写了——用了环境变量就别再改 config.js（Vercel 里环境变量优先级更高）
#
# Key:   VITE_CONFIG
# Value: 一整个 JSON（字段说明见 img/env.md，完整模板就是那份文件里的 ```json 块）
#
# 本地调试时把下面这行的 # 去掉（JSON 必须压成一行；多行在 .env 里会被截断）：
# VITE_CONFIG={"metaData":{"title":"你的名字的个人主页","description":"欢迎来到我的主页","keywords":"个人主页","icon":"/favicon.ico"},"avatar":"/img/avatar.jpg","welcometitle":"Hi, I'm 你的名字","color":{"themecolor":"#FFFFFF","welcometitlecolor":"#FFFFFF","turntablecolor1":"#FFFF00","turntablecolor2":"#00FFFF"},"brightness":85,"blur":7,"tags":["标签一","标签二"],"background":{"pc":{"type":"pic","datainfo":{"title":"海洋女孩","preview":"/img/wallpaper/static/海洋女孩/image-pre.webp","url":"/img/wallpaper/static/海洋女孩/image.png"}},"mobile":{"type":"pic","datainfo":{"title":"0001","preview":"/img/wallpaper/static-mobile/0001/image-pre.webp","url":"/img/wallpaper/static-mobile/0001/image.png"}}},"polarChart":{"skills":["Vue.js","React"],"skillPoints":[80,70]},"socialPlatformIcons":[{"icon":"mdi-github","link":"https://github.com/you"},{"icon":"mdi-email","link":"mailto:you@example.com"}],"typeWriterStrings":["一句话。"],"musicPlayer":{"server":"netease","type":"playlist","id":"2028178887","randomFirstPlay":true,"startIndex":0},"wallpaper":{"pic":[{"title":"海洋女孩","preview":"/img/wallpaper/static/海洋女孩/image-pre.webp","url":"/img/wallpaper/static/海洋女孩/image.png"}]},"projectcards":[{"title":"Project 1","describe":"一句话介绍","link":"https://example.com"}]}
